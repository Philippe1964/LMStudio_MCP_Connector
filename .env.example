# LM Studio Server Endpoint (default: http://127.0.0.1:1234)
LMSTUDIO_API_URL=http://127.0.0.1:1234

# Chat Model Identifier / Fallback (auto-detected dynamically from loaded model in LM Studio if omitted or "default")
LMSTUDIO_CHAT_MODEL=default
LMSTUDIO_FALLBACK_CHAT_MODEL=default

# Embedding Model Identifier / Fallback (auto-detected dynamically from loaded model if omitted)
LMSTUDIO_FALLBACK_EMBED_MODEL=text-embedding-nomic-embed-text-v1.5

# HTTP Request Timeout in milliseconds (default: 60000)
LMSTUDIO_TIMEOUT_MS=60000
